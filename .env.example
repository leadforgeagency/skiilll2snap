# Snap2Skill environment variables.
# Local: copy to .env. Vercel: Project → Settings → Environment Variables (do NOT commit real keys).

# REQUIRED for live vision + sandbox — Google AI Studio key, used ONLY for open-weight Gemma models
# Get it: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# REQUIRED — Google AI Studio key (used ONLY for open-weight Gemma models)
# Get it: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# OPTIONAL — ElevenLabs key (voice layer: Scribe STT, TTS narration, voice cloning)
# Get it: ElevenLabs dashboard → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_key_here
# Optional: a pre-created Professional Clone voice_id to narrate skills
ELEVENLABS_VOICE_ID=
